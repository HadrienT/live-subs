{
  "name": "live-subs-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Near-live Japanese + English subtitles for YouTube streams",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit && npm run build && web-ext lint --source-dir dist",
    "test": "vitest run",
    "start": "npm run build && web-ext run --source-dir dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.7.0",
    "ws": "^8.22.0"
  }
}
