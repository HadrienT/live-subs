# live-subs server configuration. Copy to .env; every variable is optional.

# Listen address and port. In Docker the compose file binds 192.168.1.200 only.
LIVESUBS_HOST=0.0.0.0
LIVESUBS_PORT=8765
# Optional shared token checked in `hello` (enough on the LAN).
LIVESUBS_TOKEN=
LIVESUBS_LOG_LEVEL=info

# --- Ingest & VAD (WP03)
LIVESUBS_RING_SECONDS=30
# silero (default) | energy (tests only)
LIVESUBS_VAD_BACKEND=silero
LIVESUBS_VAD_THRESHOLD=0.5
LIVESUBS_MIN_SPEECH_MS=250
# End of sentence → final
LIVESUBS_MIN_SILENCE_MS=400
# Forced cut of uninterrupted speech
LIVESUBS_MAX_SEGMENT_S=12
LIVESUBS_PAD_MS=200
# Cadence of partials while a segment is open
LIVESUBS_PARTIAL_INTERVAL_S=1.0

# --- ASR (WP04/WP05). Defaults = WP04 bench winner (ADR-002)
# faster-whisper | fake (no GPU) | none (VAD only, empty finals)
LIVESUBS_ASR_BACKEND=faster-whisper
LIVESUBS_ASR_MODEL=kotoba-whisper-v2.0
LIVESUBS_ASR_DEVICE=cuda:0
LIVESUBS_ASR_COMPUTE_TYPE=float16
LIVESUBS_ASR_BEAM_SIZE=1
# initial_prompt = glossary terms + last finals; a wrong context propagates
LIVESUBS_ASR_USE_PROMPT=true
LIVESUBS_ASR_PROMPT_CHARS=50
# Hallucination guard (see ADR-002 for why the sparse rule exists)
LIVESUBS_ASR_NO_SPEECH_PROB=0.6
LIVESUBS_ASR_NO_SPEECH_LOGPROB=-1.0
LIVESUBS_ASR_MAX_COMPRESSION_RATIO=2.4
LIVESUBS_ASR_SPARSE_LOGPROB=-0.3
LIVESUBS_ASR_SPARSE_CHARS_PER_S=2.0
# numpy/OpenBLAS/CTranslate2 threads: the host is shared
LIVESUBS_CPU_THREADS=4

# --- Translation (WP06): AgenticEnv's llama-server (ADR-003)
# llama | fake | none
LIVESUBS_MT_BACKEND=llama
# Outside Docker. From a container: http://172.17.0.1:8001/v1 (llama-bridge)
LIVESUBS_LLM_BASE_URL=http://127.0.0.1:8000/v1
# Name of the model of AgenticEnv's `translate` profile, as /v1/models lists it.
# If another model is served, live-subs says so (mt_model_inactive) and does not translate.
LIVESUBS_LLM_MODEL=plamo-2-translate
# chat (instruct models) | plamo (PLaMo 2 Translate raw format) | auto (plamo if the name says so)
LIVESUBS_LLM_PROMPT_FORMAT=auto
LIVESUBS_LLM_TEMPERATURE=0.2
LIVESUBS_LLM_MAX_TOKENS=120
LIVESUBS_LLM_DISABLE_THINKING=true
LIVESUBS_MT_TIMEOUT_S=8
# More than this many segments waiting → merged into one request
LIVESUBS_MT_MERGE_AFTER=3
LIVESUBS_MT_HISTORY=6
# <channel_id>.toml files (default: glossaries/ at the repo root)
LIVESUBS_GLOSSARY_DIR=

# --- Extension signing (WP11): addons.mozilla.org → Developer Hub → API keys.
# Never commit them.
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=

# --- Deployment (WP10)
# Explicit, slow CPU fallback. Without it the server refuses to start without GPU.
LIVESUBS_ALLOW_CPU=false
# Models only from the cache (set in the image; `just fetch-models` fills it)
LIVESUBS_ASR_LOCAL_ONLY=false
# Pin the Hugging Face commit of the ASR model (WP04 records the tested one)
LIVESUBS_ASR_REVISION=

# --- Ahead-of-live mode (WP13): the server pulls the live (yt-dlp + ffmpeg, in the image)
LIVESUBS_AHEAD_ENABLED=true
# Seconds of captured audio used to align the pulled live on the player
LIVESUBS_AHEAD_CAPTURE_WINDOW_S=15
# How far ahead of the player the pulled live may be
LIVESUBS_AHEAD_MAX_LAG_S=120
# Not aligned after this long → back to transcribing the capture
LIVESUBS_AHEAD_FAIL_AFTER_S=45
